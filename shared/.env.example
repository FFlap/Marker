# Convex CLI target. Copy to .env.local and select the existing shared deployment.
CONVEX_DEPLOYMENT=dev:your-deployment

# Set these server-only values on the Convex deployment, not in client env files:
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# npx convex env set EXTENSION_ORIGINS chrome-extension://your-extension-id
# npx convex env set TMDB_API_READ_ACCESS_TOKEN ...
# npx convex env set TVDB_API_KEY ...
