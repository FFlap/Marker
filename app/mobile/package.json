{
  "name": "@marker/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/expo": "^4.2.1",
    "@expo-google-fonts/albert-sans": "^0.4.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "expo": "~57.0.12",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.24.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.54",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "npm run architecture:check && npm run lint && npm run typecheck && npm run format:check && npm test && npm run test:ui",
    "architecture:check": "node scripts/check-file-size.mjs",
    "audit:prod": "node ../../scripts/audit-production.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "jest --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "@expo/xcpretty": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "uuid": "11.1.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/ui/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/ui/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@rn-primitives/.*|expo|expo-.*|@expo/.*|expo-router|standard-navigation|@react-navigation/.*|react-native-svg|react-native-reanimated|react-native-worklets|react-native-css-interop|nativewind|lucide-react-native.*)/)"
    ]
  },
  "private": true
}
