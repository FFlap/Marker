{
  "expo": {
    "name": "Marker",
    "slug": "marker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marker",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fflap.marker",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fflap.marker",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Marker uses your selected photo as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#0A0A0B",
            "cropToolbarIconColor": "#F4F4F5",
            "cropToolbarActionTextColor": "#F4F4F5",
            "cropBackButtonIconColor": "#F4F4F5",
            "cropBackgroundColor": "#0A0A0B"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#0A0A0B",
              "cropToolbarIconColor": "#F4F4F5",
              "cropToolbarActionTextColor": "#F4F4F5",
              "cropBackButtonIconColor": "#F4F4F5",
              "cropBackgroundColor": "#0A0A0B"
            }
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "@clerk/expo",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
