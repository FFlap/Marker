# Optional build-time override. The resulting URL is pinned into the extension bundle.
WXT_CONVEX_URL=https://your-deployment.convex.cloud
WXT_CLERK_PUBLISHABLE_KEY=pk_test_your_key
# The site that owns Clerk authentication and acts as Clerk's extension Sync Host.
WXT_WEBSITE_URL=https://marker.example.com
WXT_CLERK_SYNC_HOST=https://marker.example.com
